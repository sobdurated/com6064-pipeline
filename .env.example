# Copy this file to `.env` and fill in your own values.
# Never commit `.env` (it is gitignored).

# MongoDB connection
# Local example: mongodb://localhost:27017
# Atlas example: mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI=

# Database name to use within your MongoDB instance
MONGO_DB_NAME=COM6064

# Sentiment step configuration
# The collection containing preprocessed posts.
MONGO_SOURCE_COLLECTION=posts_processed

# Batch size for HuggingFace inference (reduce if you run out of RAM/VRAM)
SENTIMENT_BATCH_SIZE=16

# Max tokenized length / truncation length used by the model
SENTIMENT_MAX_TEXT_LEN=512

#The API keys are stored here
SERPER_API_KEYS=key1,key2,key3
